{
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "GroupId": "retry-service-group",
    "RestProxyBaseUrl": "http://localhost:8082",
    "SendFailedTopic": "send_failed",
    "SendRetryTopic": "send_retry",
    "DeadLetterTopic": "dead_letter",
    "MaxRetryCount": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
