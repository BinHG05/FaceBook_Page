{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NormalizedWebhookEvent",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Unique identifier for this internal normalized event"
    },
    "source": {
      "type": "string",
      "description": "Source origin of the event, e.g. facebook"
    },
    "eventType": {
      "type": "string",
      "description": "Type of event, e.g. feed_comment, messaging"
    },
    "topic": {
      "type": "string",
      "description": "Kafka topic destination"
    },
    "sourceEventId": {
      "type": ["string", "null"]
    },
    "pageId": {
      "type": ["string", "null"]
    },
    "pageName": {
      "type": ["string", "null"]
    },
    "objectType": {
      "type": ["string", "null"]
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "occurredAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "actor": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": ["string", "null"] }
      },
      "required": ["id"]
    },
    "target": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "string" },
        "parentId": { "type": ["string", "null"] },
        "targetType": { "type": ["string", "null"] }
      },
      "required": ["id"]
    },
    "messageText": {
      "type": ["string", "null"]
    },
    "metadata": {
      "type": "object"
    },
    "rawPayload": {
      "type": ["object", "null"]
    }
  },
  "required": ["eventId", "source", "eventType", "topic", "receivedAt"]
}

